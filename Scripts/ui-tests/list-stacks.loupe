# A stack's bottom row in the lists hides and shows the PRs stacked on it; a search holds it open.
wait settled
expect button ~"gazette #273"
action "Hide stacked PRs" on button ~"gazette #272"
expect button ~"gazette #273" missing
snap list-stack-folded
action "Show stacked PRs" on button ~"gazette #272"
expect button ~"gazette #273" exists
action "Hide stacked PRs" on button ~"gazette #272"
press cmd+f
type "BatchCache"
expect button ~"gazette #273" exists
