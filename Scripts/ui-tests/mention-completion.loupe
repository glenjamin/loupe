# Typing "@" in a comment box offers who to mention, as github.com does, those taking part in
# the PR first: part of a login or name narrows them, and ↩ puts the "@login" and a space in
# place of what was typed. An email address's "@" offers no one.
wait settled
open tamarinworks/atrium#2928
wait settled
click image #doc
wait settled
scroll scroll 2 down 300
hover textarea up 11
click button "Add a comment"
wait until text "Comment on line 22"

# Typed before the repo's people may have come, and offered again once they have.
type "@kit"
wait until textarea 2 has value "@kit"
wait settled
press return
wait until textarea 2 has value "@kit-vance "

type "or @Holl"
press return
wait until textarea 2 has value "@kit-vance or @jules-hollis "

type "x@ki"
press return
wait until textarea 2 has value "@kit-vance or @jules-hollis x@ki\n"
