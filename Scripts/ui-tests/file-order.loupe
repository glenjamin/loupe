# The picker above the file list orders the files top down, as a tab opens, once their
# dependencies are found (by folder if none of them use each other), or by folder, or bottom up: in dependency order the files are in
# groups under headers, each with its folder after its name. View ▸ Next File Order's ⌃⌘O
# steps through the orders, the picker following.
wait settled
open tamarinworks/gazette#273
wait settled
# main.go imports the batch package the PR adds, so its files open on main.go, above the
# package, which stays shown as the order changes; its doc uses nothing.
expect radio "Top down" in #file-order has value "1"
wait until ~"Group 1 (2)"
expect ~"Standalone (1)"
expect text "main.go" 1
press ctrl+2
wait settled
expect text "cmd/gazette/main.go" in #file-header
snap gazette-top-down list 1

click radio "Bottom up" in #file-order
expect radio "Bottom up" in #file-order has value "1"
expect text "status.go" 1
expect text "cmd/gazette/main.go" in #file-header
snap gazette-bottom-up list 1

press ctrl+cmd+o
expect radio "Folders" in #file-order has value "1"
wait until ~"Group 1" missing
expect "cmd/gazette"
expect text "status.go" 1

press ctrl+cmd+o
expect radio "Top down" in #file-order has value "1"
wait until ~"Group 1 (2)"

# atrium #2928's files use none of each other, so it opens by folder, as a tree; picking top
# down lists them all as standalone, in the tree's order.
open tamarinworks/atrium#2928
wait settled
expect radio "Folders" in #file-order has value "1"
expect "kiln/models/recipe"
expect ~"Standalone" missing
click radio "Top down" in #file-order
wait until ~"Standalone (3)"
expect "ledger/kiln/models/recipe"
