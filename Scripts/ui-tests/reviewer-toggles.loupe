# Clicking one row of the Reviewers picker after another, as fast as the run can, asks or
# withdraws the person each click lands on, and leaves every row where it was. A snapshot run
# refuses each write before it reaches GitHub, so each is undone at once and says so; the
# tests cover writes that are still on their way.
wait settled
open tamarinworks/gazette#272
wait settled
click button "Reviewers"
wait until #reviewer-choice in #reviewer-picker
expect #reviewer-choice 1 in #reviewer-picker has label "pat-barrow, Pat Barrow"
expect #reviewer-choice 3 in #reviewer-picker has label "jules-hollis, Jules Hollis"
expect #reviewer-choice 4 in #reviewer-picker has label "tam-fairweather, Tam Fairweather"

click #reviewer-choice 3 in #reviewer-picker
expect text ~"ask jules-hollis" in #reviewer-picker
click #reviewer-choice 4 in #reviewer-picker
expect text ~"ask tam-fairweather" in #reviewer-picker
click #reviewer-choice 1 in #reviewer-picker
expect text ~"remove pat-barrow" in #reviewer-picker
expect-request requestReviews
expect-request requested_reviewers

expect #reviewer-choice 1 in #reviewer-picker has label "pat-barrow, Pat Barrow"
expect #reviewer-choice 1 in #reviewer-picker has value "Requested"
expect #reviewer-choice 3 in #reviewer-picker has label "jules-hollis, Jules Hollis"
expect #reviewer-choice 3 in #reviewer-picker has no value "Requested"
expect #reviewer-choice 4 in #reviewer-picker has label "tam-fairweather, Tam Fairweather"
expect #reviewer-choice in #reviewer-picker count 8
snap reviewer-toggles #reviewer-picker
