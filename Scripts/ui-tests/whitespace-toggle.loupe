# The file header's Hide whitespace checkbox flips the PR's setting when clicked, and View ▸ Hide
# Whitespace's ⌃⌘H flips it too, the checkbox following.
wait settled
open tamarinworks/atrium#2928
wait settled
click image #doc
wait until checkbox "Hide whitespace" in #file-header
expect checkbox "Hide whitespace" has value "0"
snap whitespace-shown #file-header

click checkbox "Hide whitespace" in #file-header
expect checkbox "Hide whitespace" has value "1"
snap whitespace-hidden #file-header
expect-different whitespace-shown whitespace-hidden
# The diff takes no clicks until the one without whitespace has replaced it.
wait settled

click checkbox "Hide whitespace" in #file-header
expect checkbox "Hide whitespace" has value "0"
snap whitespace-shown-again #file-header
expect-same whitespace-shown whitespace-shown-again

press ctrl+cmd+h
expect checkbox "Hide whitespace" has value "1"
snap whitespace-hidden-by-key #file-header
expect-same whitespace-hidden whitespace-hidden-by-key

press ctrl+cmd+h
expect checkbox "Hide whitespace" has value "0"
